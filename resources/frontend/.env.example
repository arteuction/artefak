# NestJS API base URL (proxied in dev, set to full URL in production)
VITE_API_BASE_URL=/api/v1

# Storage CDN for artwork images
VITE_STORAGE_URL=https://your-cdn.example

# WebSocket gateway is part of the NestJS API server (socket.io /bids namespace)
# No additional env vars needed — the socket connects to the same host as VITE_API_BASE_URL
