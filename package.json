{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "generate:api-types": "npx @hey-api/openapi-ts@0.67.1 --input resources/js/api/openapi.json --output resources/js/api/generated --client @hey-api/client-axios",
        "check:api-types": "php artisan scramble:export --path=resources/js/api/openapi.json --env=testing && npm run generate:api-types",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "audit:prod": "npm audit --omit=dev --audit-level=high",
        "audit:all": "npm audit --audit-level=critical"
    },
    "devDependencies": {
        "@hey-api/client-axios": "^0.9.1",
        "@hey-api/openapi-ts": "^0.67.1",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.104.1",
        "@uppy/aws-s3": "^6.2.2",
        "@uppy/core": "^6.2.0",
        "@uppy/dashboard": "^6.0.1",
        "@uppy/react": "^6.0.0",
        "axios": "^1.20.0",
        "laravel-echo": "^2.6.1",
        "pusher-js": "^8.6.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4"
    }
}
