APP_NAME="ARTeuCtion"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://euction.artefak.eu
APP_TIMEZONE=Europe/Sofia

LOG_CHANNEL=daily
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arteuction
DB_USERNAME=arteuction
DB_PASSWORD=CHANGE_ME

# ── No Redis on production (1GB VPS) ─────────────────────────────────────────
# All three Laravel subsystems use lightweight database/file drivers.
# Redis is not installed and not needed on single-node.

CACHE_STORE=file          # zero DB queries; invalidated on deploy via artisan cache:clear
SESSION_DRIVER=database        # consistent cross-request sessions; table: sessions
SESSION_SECURE_COOKIE=true     # HTTPS-only; never sent over plaintext HTTP
SESSION_SAME_SITE=lax          # Protects against CSRF; lax allows top-level navigation (Stripe redirects, OAuth callbacks)
SESSION_ENCRYPT=true           # Encrypt payload at rest; requires APP_KEY
QUEUE_CONNECTION=database # adequate for pilot traffic; table: jobs

# ── Full-text search — MariaDB FULLTEXT (no Meilisearch process) ──────────────
# Swap to meilisearch + SCOUT_DRIVER=meilisearch after load justifies it.
SCOUT_DRIVER=database

# ── Broadcasting — Reverb (single-node, no Redis) ────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=arteuction
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false   # no Redis needed for single-node

# ── File storage — S3-compatible cloud (no self-hosted MinIO on 1GB VPS) ──────
# Cloudflare R2 (zero egress fees) or Backblaze B2 recommended.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
AWS_BUCKET=arteuction-artworks
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public CDN/R2 base URL for artwork images (no trailing slash)
# e.g. https://pub-HASH.r2.dev  or  https://images.artefak.eu
VITE_STORAGE_URL=https://pub-CHANGE_ME.r2.dev

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_live_CHANGE_ME
STRIPE_SECRET=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@artefak.eu
MAIL_FROM_NAME="${APP_NAME}"
