# NestJS API — staging environment template
# Copy to .env.staging and fill in actual values (never commit .env.staging)

NODE_ENV=production
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://arteuction:secret@mariadb:3306/arteuction

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-32-chars-minimum
JWT_EXPIRY=7d

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=arteuction-artworks
AWS_ENDPOINT_URL=http://minio:9000

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=staging_master_key

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM_ADDRESS=noreply@arteuction.com
MAIL_FROM_NAME=ARTeuCtion

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://staging.arteuction.com
