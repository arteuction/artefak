  settlement_lines       settlement_lines       @relation(fields: [settlement_line_id], references: [id], onUpdate: Restrict, map: "transfer_outbox_settlement_line_id_foreign")

  @@unique([settlement_line_id, attempt], map: "outbox_line_attempt_unique")
  @@index([next_attempt_at], map: "transfer_outbox_next_attempt_at_index")
}

model transfer_reversal_orders {
  id                    BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  refund_line_id        BigInt                          @unique(map: "tro_refund_line_unique") @db.UnsignedBigInt
  stripe_transfer_id    String                          @db.VarChar(255)
  amount_cents          Int                             @db.UnsignedInt
  currency              String                          @default("EUR") @db.Char(3)
  idempotency_key       String                          @unique(map: "transfer_reversal_orders_idempotency_key_unique") @db.VarChar(255)
  status                transfer_reversal_orders_status @default(pending)
  attempt               Int                             @default(0) @db.UnsignedTinyInt
  last_error            String?                         @db.Text
  next_attempt_at       DateTime?                       @db.Timestamp(0)
  processing_started_at DateTime?                       @db.Timestamp(0)
  stripe_reversal_id    String?                         @db.VarChar(255)
  reversed_at           DateTime?                       @db.Timestamp(0)
  created_at            DateTime?                       @db.Timestamp(0)
  updated_at            DateTime?                       @db.Timestamp(0)
  refund_lines          refund_lines                    @relation(fields: [refund_line_id], references: [id], onUpdate: Restrict, map: "transfer_reversal_orders_refund_line_id_foreign")

  @@index([next_attempt_at], map: "transfer_reversal_orders_next_attempt_at_index")
}

model user_consents {
  id                   BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt              @db.UnsignedBigInt
  governance_policy_id BigInt              @db.UnsignedBigInt
  consented_at         DateTime            @db.Timestamp(0)
  ip_address           String?             @db.VarChar(45)
  user_agent           String?             @db.VarChar(512)
  withdrawn_at         DateTime?           @db.Timestamp(0)
  created_at           DateTime?           @db.Timestamp(0)
  updated_at           DateTime?           @db.Timestamp(0)
  governance_policies  governance_policies @relation(fields: [governance_policy_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_consents_governance_policy_id_foreign")
  users                User                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_consents_user_id_foreign")

  @@unique([user_id, governance_policy_id], map: "user_consents_user_id_governance_policy_id_unique")
  @@index([governance_policy_id], map: "user_consents_governance_policy_id_foreign")
  @@index([user_id, consented_at], map: "user_consents_user_id_consented_at_index")
}

model venues {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String                 @db.VarChar(255)
  slug                 String                 @unique(map: "venues_slug_unique") @db.VarChar(255)
  type                 venues_type            @default(private)
  geo_locality_id      BigInt                 @db.UnsignedBigInt
  metro_stop_id        BigInt?                @db.UnsignedBigInt
  address              String?                @db.VarChar(255)
  latitude             Decimal?               @db.Decimal(10, 7)
  longitude            Decimal?               @db.Decimal(10, 7)
  phone                String?                @db.VarChar(30)
  email                String?                @db.VarChar(120)
  website              String?                @db.VarChar(255)
  opening_hours        String?                @db.LongText
  description          String?                @db.Text
  is_active            Boolean                @default(true)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  artmetro_route_stops artmetro_route_stops[]
  auctions             Auction[]
  exhibitions          exhibitions[]
  galleries            galleries[]
  geo_localities       geo_localities         @relation(fields: [geo_locality_id], references: [id], onUpdate: Restrict, map: "venues_geo_locality_id_foreign")
  metro_stops          metro_stops?           @relation(fields: [metro_stop_id], references: [id], onUpdate: Restrict, map: "venues_metro_stop_id_foreign")

  @@index([geo_locality_id, is_active], map: "venues_geo_locality_id_is_active_index")
  @@index([latitude, longitude], map: "venues_latitude_longitude_index")
  @@index([metro_stop_id], map: "venues_metro_stop_id_foreign")
}

model watchlist {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  subject_type String    @db.VarChar(100)
  subject_id   BigInt    @db.UnsignedBigInt
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "watchlist_user_id_foreign")

  @@unique([user_id, subject_type, subject_id], map: "watchlist_user_subject_unique")
  @@index([subject_type, subject_id], map: "watchlist_subject_type_subject_id_index")
}

model webhook_events {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  stripe_event_id String                @unique(map: "webhook_events_stripe_event_id_unique") @db.VarChar(255)
  type            String                @db.VarChar(255)
  payload         String                @db.LongText
  status          webhook_events_status @default(received)
  error           String?               @db.Text
  created_at      DateTime?             @db.Timestamp(0)
  updated_at      DateTime?             @db.Timestamp(0)
}

