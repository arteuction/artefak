generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                          BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  name                                                        String                    @db.VarChar(255)
  email                                                       String                    @unique(map: "users_email_unique") @db.VarChar(255)
  role                                                        users_role                @default(buyer)
  email_verified_at                                           DateTime?                 @db.Timestamp(0)
  password                                                    String                    @db.VarChar(255)
  remember_token                                              String?                   @db.VarChar(100)
  created_at                                                  DateTime?                 @db.Timestamp(0)
  updated_at                                                  DateTime?                 @updatedAt @db.Timestamp(0)
  admin_audit_log                                             admin_audit_log[]
  api_clients                                                 api_clients[]
  art_lots                                                    art_lots[]
  artist_applications                                         artist_applications[]
  artist_profiles_artist_profiles_reviewed_byTousers          artist_profiles[]         @relation("artist_profiles_reviewed_byTousers")
  artist_profiles_artist_profiles_user_idTousers              artist_profiles?          @relation("artist_profiles_user_idTousers")
  artmetro_artifact_scans                                     artmetro_artifact_scans[]
  artmetro_visits                                             artmetro_visits[]
  artwork_revisions                                           artwork_revisions[]
  artwork_sdg_claims                                          artwork_sdg_claims[]
  artworks                                                    artworks[]
  auction_fulfillments                                        auction_fulfillments[]
  auction_items                                               AuctionItem[]
  bids                                                        Bid[]
  bookAuthors                                                 BookAuthor[]              @relation("BookAuthors")
  book_entitlements                                           book_entitlements[]
  book_files                                                  book_files[]
  book_purchases                                              book_purchases[]
  ownedBooks                                                  Book[]                    @relation("BookOwner")
  books_books_reviewed_byTousers                              Book[]                    @relation("books_reviewed_byTousers")
  collections                                                 collections[]
  condition_reports                                           condition_reports[]
  consignments_consignments_consignor_idTousers               consignments[]            @relation("consignments_consignor_idTousers")
  consignments_consignments_owner_idTousers                   consignments[]            @relation("consignments_owner_idTousers")
  dispute_escalations_dispute_escalations_assigned_toTousers  dispute_escalations[]     @relation("dispute_escalations_assigned_toTousers")
  dispute_escalations_dispute_escalations_escalated_byTousers dispute_escalations[]     @relation("dispute_escalations_escalated_byTousers")
  donations                                                   donations[]
  gallery_staff_gallery_staff_invited_byTousers               gallery_staff[]           @relation("gallery_staff_invited_byTousers")
  gallery_staff_gallery_staff_user_idTousers                  gallery_staff[]           @relation("gallery_staff_user_idTousers")
  impact_evidence                                             impact_evidence[]
  max_bids                                                    max_bids[]
  notification_records                                        notification_records[]
  ownership_transfers_ownership_transfers_from_user_idTousers ownership_transfers[]     @relation("ownership_transfers_from_user_idTousers")
  ownership_transfers_ownership_transfers_to_user_idTousers   ownership_transfers[]     @relation("ownership_transfers_to_user_idTousers")
  reserves                                                    reserves[]
  sell_now_offers                                             sell_now_offers[]
  settlement_lines                                            settlement_lines[]
  user_consents                                               user_consents[]
  watchlist                                                   watchlist[]

  @@map("users")
}

model Book {
  id                             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  owner_id                       BigInt              @db.UnsignedBigInt
  title                          String              @db.VarChar(255)
  slug                           String              @unique(map: "books_slug_unique") @db.VarChar(255)
  description                    String?             @db.Text
  short_description              String?             @db.Text
  isbn                           String?             @db.VarChar(20)
  publisher                      String?             @db.VarChar(200)
  language                       String?             @db.VarChar(10)
  edition                        String?             @db.VarChar(50)
  page_count                     Int?                @db.UnsignedSmallInt
  publication_year               Int?                @db.Year
  country_origin                 String?             @db.VarChar(60)
  price_cents                    Int                 @default(0) @db.UnsignedInt
  currency                       String              @default("EUR") @db.Char(3)
  is_free                        Boolean             @default(false)
  preview_pages                  Int                 @default(0) @db.UnsignedSmallInt
  status                         books_status        @default(draft)
  reviewed_by                    BigInt?             @db.UnsignedBigInt
  reviewed_at                    DateTime?           @db.Timestamp(0)
  review_note                    String?             @db.Text
  is_featured                    Boolean             @default(false)
  current_file_version           BigInt?             @db.UnsignedBigInt
  created_at                     DateTime?           @db.Timestamp(0)
  updated_at                     DateTime?           @updatedAt @db.Timestamp(0)
  deleted_at                     DateTime?           @db.Timestamp(0)
  authors                        BookAuthor[]
  book_entitlements              book_entitlements[]
  book_files                     book_files[]
  book_purchases                 book_purchases[]
  owner                          User                @relation("BookOwner", fields: [owner_id], references: [id], onUpdate: Restrict, map: "books_owner_id_foreign")
  users_books_reviewed_byTousers User?               @relation("books_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: Restrict, map: "books_reviewed_by_foreign")

  @@index([isbn], map: "books_isbn_index")
  @@index([owner_id], map: "books_owner_id_index")
  @@index([reviewed_by], map: "books_reviewed_by_foreign")
  @@index([status, is_featured], map: "books_status_is_featured_index")
  @@map("books")
}

model BookAuthor {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  book_id    BigInt    @db.UnsignedBigInt
  author_id  BigInt    @db.UnsignedBigInt
  share_bps  Int       @db.UnsignedSmallInt
  sort_order Int       @default(0) @db.UnsignedTinyInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @updatedAt @db.Timestamp(0)
  author     User      @relation("BookAuthors", fields: [author_id], references: [id], onUpdate: Restrict, map: "book_authors_author_id_foreign")
  book       Book      @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_authors_book_id_foreign")

  @@unique([book_id, author_id], map: "book_authors_book_id_author_id_unique")
  @@index([author_id], map: "book_authors_author_id_foreign")
  @@index([book_id], map: "book_authors_book_id_index")
  @@map("book_authors")
}

model Auction {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  title            String            @db.VarChar(255)
  slug             String            @unique(map: "auctions_slug_unique") @db.VarChar(255)
  venue_id         BigInt?           @db.UnsignedBigInt
  ruleset_id       BigInt?           @db.UnsignedBigInt
  starts_at        DateTime          @db.Timestamp(0)
  ends_at          DateTime          @db.Timestamp(0)
  status           auctions_status   @default(draft)
  currency         String            @default("EUR") @db.VarChar(3)
  description      String?           @db.Text
  created_at       DateTime?         @db.Timestamp(0)
  updated_at       DateTime?         @updatedAt @db.Timestamp(0)
  items            AuctionItem[]
  auction_rulesets auction_rulesets? @relation(fields: [ruleset_id], references: [id], onUpdate: Restrict, map: "auctions_ruleset_id_foreign")
  venues           venues?           @relation(fields: [venue_id], references: [id], onUpdate: Restrict, map: "auctions_venue_id_foreign")
  exhibitions      exhibitions[]

  @@index([ruleset_id], map: "auctions_ruleset_id_foreign")
  @@index([status, starts_at], map: "auctions_status_starts_at_index")
  @@index([venue_id], map: "auctions_venue_id_foreign")
  @@map("auctions")
}

model AuctionItem {
  id                                      BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  auction_id                              BigInt                           @db.UnsignedBigInt
  art_lot_id                              BigInt                           @db.UnsignedBigInt
  lot_number                              Int                              @db.UnsignedSmallInt
  bid_increment_cents                     BigInt?                          @db.UnsignedBigInt
  status                                  auction_items_status             @default(pending)
  winning_bid_id                          BigInt?                          @db.UnsignedBigInt
  winner_user_id                          BigInt?                          @db.UnsignedBigInt
  payment_deadline                        DateTime?                        @db.Timestamp(0)
  fulfillment_status                      auction_items_fulfillment_status @default(none)
  created_at                              DateTime?                        @db.Timestamp(0)
  updated_at                              DateTime?                        @updatedAt @db.Timestamp(0)
  auction_fulfillments                    auction_fulfillments?
  art_lots                                art_lots                         @relation(fields: [art_lot_id], references: [id], onUpdate: Restrict, map: "auction_items_art_lot_id_foreign")
  auction                                 Auction                          @relation(fields: [auction_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "auction_items_auction_id_foreign")
  users                                   User?                            @relation(fields: [winner_user_id], references: [id], onUpdate: Restrict, map: "auction_items_winner_user_id_foreign")
  bids_auction_items_winning_bid_idTobids Bid?                             @relation("auction_items_winning_bid_idTobids", fields: [winning_bid_id], references: [id], onUpdate: Restrict, map: "auction_items_winning_bid_id_foreign")
  bids                                    Bid[]
  donations                               donations[]
  impact_events                           impact_events[]
  max_bids                                max_bids[]
  ownership_transfers                     ownership_transfers[]
  reserves                                reserves?

  @@unique([auction_id, art_lot_id], map: "auction_items_auction_id_art_lot_id_unique")
  @@unique([auction_id, lot_number], map: "auction_items_auction_id_lot_number_unique")
  @@index([art_lot_id], map: "auction_items_art_lot_id_index")
  @@index([fulfillment_status], map: "auction_items_fulfillment_status_index")
  @@index([status], map: "auction_items_status_index")
  @@index([winner_user_id], map: "auction_items_winner_user_id_foreign")
  @@index([winning_bid_id], map: "auction_items_winning_bid_id_index")
  @@map("auction_items")
}

model Bid {
  id                                               BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  auction_item_id                                  BigInt               @db.UnsignedBigInt
  user_id                                          BigInt               @db.UnsignedBigInt
  amount_cents                                     BigInt               @db.UnsignedBigInt
  status                                           bids_status          @default(pending)
  stripe_payment_intent_id                         String?              @db.VarChar(100)
  authorization_expires_at                         DateTime?            @db.Timestamp(0)
  payment_status                                   bids_payment_status?
  ip_address                                       String?              @db.VarChar(45)
  bid_type                                         bids_bid_type        @default(live)
  max_bid_id                                       BigInt?              @db.UnsignedBigInt
  created_at                                       DateTime?            @db.Timestamp(0)
  updated_at                                       DateTime?            @updatedAt @db.Timestamp(0)
  auction_items_auction_items_winning_bid_idTobids AuctionItem[]        @relation("auction_items_winning_bid_idTobids")
  auction_item                                     AuctionItem          @relation(fields: [auction_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bids_auction_item_id_foreign")
  max_bids                                         max_bids?            @relation(fields: [max_bid_id], references: [id], onUpdate: Restrict, map: "bids_max_bid_id_foreign")
  user                                             User                 @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "bids_user_id_foreign")

  @@index([auction_item_id, amount_cents], map: "bids_auction_item_id_amount_cents_index")
  @@index([authorization_expires_at, payment_status], map: "bids_auth_expires_payment_status_index")
  @@index([max_bid_id], map: "bids_max_bid_id_foreign")
  @@index([stripe_payment_intent_id], map: "bids_stripe_payment_intent_id_index")
  @@index([user_id, status], map: "bids_user_id_status_index")
  @@map("bids")
}

model activity_log {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  log_name          String?   @db.VarChar(255)
  description       String    @db.Text
  subject_type      String?   @db.VarChar(255)
  subject_id        BigInt?   @db.UnsignedBigInt
  event             String?   @db.VarChar(255)
  causer_type       String?   @db.VarChar(255)
  causer_id         BigInt?   @db.UnsignedBigInt
  attribute_changes String?   @db.LongText
  properties        String?   @db.LongText
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)

  @@index([log_name], map: "activity_log_log_name_index")
  @@index([causer_type, causer_id], map: "causer")
  @@index([subject_type, subject_id], map: "subject")
}

model admin_audit_log {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actor_id     BigInt   @db.UnsignedBigInt
  subject_type String   @db.VarChar(255)
  subject_id   BigInt   @db.UnsignedBigInt
  action       String   @db.VarChar(80)
  payload      String?  @db.LongText
  created_at   DateTime @default(now()) @db.Timestamp(0)
  users        User     @relation(fields: [actor_id], references: [id], onUpdate: Restrict, map: "admin_audit_log_actor_id_foreign")

  @@index([action], map: "admin_audit_log_action_index")
  @@index([actor_id, created_at], map: "admin_audit_log_actor_id_created_at_index")
  @@index([subject_type, subject_id], map: "admin_audit_log_subject_type_subject_id_index")
}

model api_clients {
  id                    BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String        @db.VarChar(255)
  key_hash              String        @unique(map: "api_clients_key_hash_unique") @db.VarChar(64)
  key_prefix            String        @db.VarChar(12)
  user_id               BigInt?       @db.UnsignedBigInt
  institution_id        BigInt?       @db.UnsignedBigInt
  scopes                String        @default("[]") @db.LongText
  rate_limit_per_minute Int?          @db.UnsignedSmallInt
  is_active             Boolean       @default(true)
  last_used_at          DateTime?     @db.Timestamp(0)
  expires_at            DateTime?     @db.Timestamp(0)
  deleted_at            DateTime?     @db.Timestamp(0)
  created_at            DateTime?     @db.Timestamp(0)
  updated_at            DateTime?     @db.Timestamp(0)
  institutions          institutions? @relation(fields: [institution_id], references: [id], onUpdate: Restrict, map: "api_clients_institution_id_foreign")
  users                 User?         @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "api_clients_user_id_foreign")

  @@index([institution_id], map: "api_clients_institution_id_foreign")
  @@index([is_active], map: "api_clients_is_active_index")
  @@index([user_id], map: "api_clients_user_id_foreign")
}

model art_lots {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  artwork_id          BigInt                @db.UnsignedBigInt
  consignor_id        BigInt?               @db.UnsignedBigInt
  gallery_id          BigInt?               @db.UnsignedBigInt
  consignment_id      BigInt?               @db.UnsignedBigInt
  artwork_revision_id BigInt?               @db.UnsignedBigInt
  sale_mode           art_lots_sale_mode    @default(auction)
  status              art_lots_status       @default(draft)
  reserve_price_cents BigInt?               @db.UnsignedBigInt
  starting_bid_cents  BigInt?               @db.UnsignedBigInt
  buy_now_price_cents BigInt?               @db.UnsignedBigInt
  buy_now_expires_at  DateTime?             @db.Timestamp(0)
  currency            String                @default("EUR") @db.Char(3)
  split_profile_key   String                @default("social_pilot_45_45_10") @db.VarChar(64)
  estimate_low_cents  BigInt?               @db.UnsignedBigInt
  estimate_high_cents BigInt?               @db.UnsignedBigInt
  published_at        DateTime?             @db.Timestamp(0)
  closed_at           DateTime?             @db.Timestamp(0)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  artworks            artworks              @relation(fields: [artwork_id], references: [id], onUpdate: Restrict, map: "art_lots_artwork_id_foreign")
  artwork_revisions   artwork_revisions?    @relation(fields: [artwork_revision_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "art_lots_artwork_revision_id_foreign")
  consignments        consignments?         @relation(fields: [consignment_id], references: [id], onUpdate: Restrict, map: "art_lots_consignment_id_foreign")
  users               User?                 @relation(fields: [consignor_id], references: [id], onUpdate: Restrict, map: "art_lots_consignor_id_foreign")
  galleries           galleries?            @relation(fields: [gallery_id], references: [id], onUpdate: Restrict, map: "art_lots_gallery_id_foreign")
  artmetro_artifacts  artmetro_artifacts[]
  auction_items       AuctionItem[]
  donations           donations[]
  impact_events       impact_events[]
  ownership_transfers ownership_transfers[]
  sell_now_offers     sell_now_offers[]

  @@index([artwork_id, status], map: "art_lots_artwork_id_status_index")
  @@index([artwork_revision_id], map: "art_lots_artwork_revision_id_foreign")
  @@index([consignment_id], map: "art_lots_consignment_id_foreign")
  @@index([consignor_id], map: "art_lots_consignor_id_foreign")
  @@index([gallery_id], map: "art_lots_gallery_id_foreign")
  @@index([sale_mode], map: "art_lots_sale_mode_index")
}

model artist_applications {
  id                BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  artist_profile_id BigInt                     @db.UnsignedBigInt
  status            artist_applications_status @default(draft)
  id_document_path  String?                    @db.VarChar(500)
  portfolio_url     String?                    @db.VarChar(500)
  motivation        String?                    @db.Text
  reviewed_by       BigInt?                    @db.UnsignedBigInt
  reviewed_at       DateTime?                  @db.Timestamp(0)
  review_note       String?                    @db.Text
  version           Int                        @default(1) @db.UnsignedSmallInt
  created_at        DateTime?                  @db.Timestamp(0)
  updated_at        DateTime?                  @db.Timestamp(0)
  artist_profiles   artist_profiles            @relation(fields: [artist_profile_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "artist_applications_artist_profile_id_foreign")
  users             User?                      @relation(fields: [reviewed_by], references: [id], onUpdate: Restrict, map: "artist_applications_reviewed_by_foreign")

  @@index([artist_profile_id, status], map: "artist_applications_artist_profile_id_status_index")
  @@index([reviewed_by], map: "artist_applications_reviewed_by_foreign")
  @@index([status], map: "artist_applications_status_index")
}

model artist_profiles {
  id                                       BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                                  BigInt                 @unique(map: "artist_profiles_user_id_unique") @db.UnsignedBigInt
  display_name                             String                 @db.VarChar(255)
  slug                                     String                 @unique(map: "artist_profiles_slug_unique") @db.VarChar(255)
  bio                                      String?                @db.Text
  website                                  String?                @db.VarChar(500)
  instagram_handle                         String?                @db.VarChar(60)
  status                                   artist_profiles_status @default(pending)
  reviewed_by                              BigInt?                @db.UnsignedBigInt
  reviewed_at                              DateTime?              @db.Timestamp(0)
  review_note                              String?                @db.Text
  terms_accepted_at                        DateTime?              @db.Timestamp(0)
  terms_version                            String?                @db.VarChar(20)
  created_at                               DateTime?              @db.Timestamp(0)
  updated_at                               DateTime?              @db.Timestamp(0)
  deleted_at                               DateTime?              @db.Timestamp(0)
  artist_applications                      artist_applications[]
  users_artist_profiles_reviewed_byTousers User?                  @relation("artist_profiles_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: Restrict, map: "artist_profiles_reviewed_by_foreign")
  users_artist_profiles_user_idTousers     User                   @relation("artist_profiles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "artist_profiles_user_id_foreign")

  @@index([reviewed_by], map: "artist_profiles_reviewed_by_foreign")
  @@index([status], map: "artist_profiles_status_index")
}

model artmetro_artifact_scans {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  artifact_id        BigInt             @db.UnsignedBigInt
  user_id            BigInt?            @db.UnsignedBigInt
  referrer           String?            @db.VarChar(500)
  campaign           String?            @db.VarChar(120)
  locale             String?            @db.VarChar(10)
  ip_address         String?            @db.VarChar(45)
  user_agent         String?            @db.VarChar(500)
  scanned_at         DateTime           @default(now()) @db.Timestamp(0)
  artmetro_artifacts artmetro_artifacts @relation(fields: [artifact_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "artmetro_artifact_scans_artifact_id_foreign")
  users              User?              @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "artmetro_artifact_scans_user_id_foreign")

  @@index([artifact_id, scanned_at], map: "artmetro_artifact_scans_artifact_id_scanned_at_index")
  @@index([campaign, scanned_at], map: "artmetro_artifact_scans_campaign_scanned_at_index")
  @@index([user_id], map: "artmetro_artifact_scans_user_id_foreign")
}

model artmetro_artifacts {
  id                      BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  exhibition_id           BigInt                    @db.UnsignedBigInt
  sellable_type           String?                   @db.VarChar(255)
  sellable_id             BigInt?                   @db.UnsignedBigInt
  art_lot_id              BigInt?                   @db.UnsignedBigInt
  title                   String                    @db.VarChar(255)
  description             String?                   @db.Text
  ar_model_url            String?                   @db.VarChar(500)
  qr_token                String                    @unique(map: "artmetro_artifacts_qr_token_unique") @db.VarChar(64)
  qr_version              Int                       @default(1) @db.UnsignedTinyInt
  is_active               Boolean                   @default(true)
  sort_order              Int                       @default(0) @db.UnsignedSmallInt
  deleted_at              DateTime?                 @db.Timestamp(0)
  created_at              DateTime?                 @db.Timestamp(0)
  updated_at              DateTime?                 @db.Timestamp(0)
  artmetro_artifact_scans artmetro_artifact_scans[]
  art_lots                art_lots?                 @relation(fields: [art_lot_id], references: [id], onUpdate: Restrict, map: "artmetro_artifacts_art_lot_id_foreign")
  exhibitions             exhibitions               @relation(fields: [exhibition_id], references: [id], onUpdate: Restrict, map: "artmetro_artifacts_exhibition_id_foreign")
  artmetro_visits         artmetro_visits[]

  @@index([art_lot_id], map: "artmetro_artifacts_art_lot_id_foreign")
  @@index([exhibition_id, is_active, sort_order], map: "artmetro_artifacts_exhibition_id_is_active_sort_order_index")
  @@index([sellable_type, sellable_id], map: "artmetro_artifacts_sellable_index")
}

model artmetro_exhibition_sdg {
  exhibition_id BigInt      @db.UnsignedBigInt
  sdg_number    Int         @db.UnsignedTinyInt
  exhibitions   exhibitions @relation(fields: [exhibition_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "artmetro_exhibition_sdg_exhibition_id_foreign")

  @@id([exhibition_id, sdg_number])
}

model artmetro_route_stops {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  route_id        BigInt          @db.UnsignedBigInt
  venue_id        BigInt          @db.UnsignedBigInt
  sort_order      Int             @default(0) @db.UnsignedSmallInt
  notes           String?         @db.Text
  created_at      DateTime?       @db.Timestamp(0)
  updated_at      DateTime?       @db.Timestamp(0)
  artmetro_routes artmetro_routes @relation(fields: [route_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "artmetro_route_stops_route_id_foreign")
  venues          venues          @relation(fields: [venue_id], references: [id], onUpdate: Restrict, map: "artmetro_route_stops_venue_id_foreign")

